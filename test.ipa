import 'dart:io';
import 'dart:async';
import 'package:flutter/material.dart';
import 'package:dio/dio.dart';
import 'package:path_provider/path_provider.dart';
import 'package:provider/provider.dart';
import 'package:percent_indicator/percent_indicator.dart'; // تحتاج لإضافتها في pubspec.yaml

// ----------------------------------------------------------------      
// 1. DATA LAYER (نظام تعريف الموديلات والقوانين)
// ----------------------------------------------------------------

enum ModelCategory { llm, vision, audio, specialized }
enum DownloadStatus { pending, downloading, verifying, completed, failed }

class AIModel {
  final String id;
  final String name;
  final String version;
  final String provider;
  final String downloadUrl;
  final String licenseType;
  final ModelCategory category;
  final String description;
  double progress = 0;
  DownloadStatus status = DownloadStatus.pending;
  String? localPath;

  AIModel({
    required this.id,
    required this.name,
    required this.version,
    required this.provider,
    required this.downloadUrl,
    required this.licenseType,
    required this.category,
    required this.description,
  });
}

// ----------------------------------------------------------------      
// 2. LOGIC & ENGINE LAYER (محرك التحميل والتحقق الأمني)
// ----------------------------------------------------------------

class AIEngineProvider extends ChangeNotifier {
  Map<String, AIModel> _library = {};
  final Dio _dio = Dio();
  
  List<AIModel> get allModels => _library.values.toList();

  AIEngineProvider() {
    _initializeLegalModels();
  }

  void _initializeLegalModels() {
    // هنا نضيف عينة من الموديلات العالمية القانونية (HuggingFace)
    var models = [
      AIModel(
        id: "meta-llama-3",
        name: "Llama 3 (8B Instruct)",
        version: "1.0.0",
        provider: "Meta AI",
        downloadUrl: "https://huggingface.co/QuantFactory/Meta-Llama-3-8B-Instruct-GGUF/resolve/main/Meta-Llama-3-8B-Instruct.Q4_K_M.gguf",
        licenseType: "Llama 3 Community License",
        category: ModelCategory.llm,
        description: "أقوى موديل مفتوح المصدر حالياً للمحادثة والاستنتاج.",
      ),
      AIModel(
        id: "mistral-7b",
        name: "Mistral v0.3",
        version: "0.3",
        provider: "Mistral AI",
        downloadUrl: "https://huggingface.co/mistralai/Mistral-7B-v0.3/resolve/main/model.safetensors",
        licenseType: "Apache 2.0",
        category: ModelCategory.llm,
        description: "موديل فرنسي عالي الكفاءة يتميز بالسرعة والدقة.",
      ),
      AIModel(
        id: "whisper-tiny",
        name: "OpenAI Whisper Tiny",
        version: "v3",
        provider: "OpenAI",
        downloadUrl: "https://huggingface.co/openai/whisper-tiny/resolve/main/flac_model.bin",
        licenseType: "MIT",
        category: ModelCategory.audio,
        description: "لتحويل الصوت إلى نص بدقة مذهلة محلياً.",
      ),
    ];
    
    for (var m in models) { _library[m.id] = m; }
    notifyListeners();
  }

  Future<void> startSecureDownload(String id) async {
    final model = _library[id];
    if (model == null) return;

    try {
      model.status = DownloadStatus.downloading;
      notifyListeners();

      final directory = await getApplicationDocumentsDirectory();
      final filePath = "${directory.path}/${model.id}_${model.version}.bin";

      await _dio.download(
        model.downloadUrl,
        filePath,
        onReceiveProgress: (received, total) {
          if (total != -1) {
            model.progress = received / total;
            notifyListeners();
          }
        },
      );

      // مرحلة التحقق الأمني (Security Check)
      model.status = DownloadStatus.verifying;
      notifyListeners();
      await Future.delayed(const Duration(seconds: 2)); // محاكاة فحص التشفير

      model.status = DownloadStatus.completed;
      model.localPath = filePath;
      notifyListeners();
      
    } catch (e) {
      model.status = DownloadStatus.failed;
      notifyListeners();
    }
  }
}

// ----------------------------------------------------------------      
// 3. UI LAYER (واجهة المستخدم بنمط iOS الاحترافي)
// ----------------------------------------------------------------

void main() {
  runApp(
    ChangeNotifierProvider(
      create: (_) => AIEngineProvider(),
      child: const AIUniverseApp(),
    ),
  );
}

class AIUniverseApp extends StatelessWidget {
  const AIUniverseApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        brightness: Brightness.light,
        primarySwatch: Colors.indigo,
        useMaterial3: true,
        fontFamily: 'Cairo', // مناسب للمستخدم العربي
      ),
      darkTheme: ThemeData.dark(useMaterial3: true),
      home: const MainModelExplorer(),
    );
  }
}

class MainModelExplorer extends StatefulWidget {
  const MainModelExplorer({super.key});

  @override
  State<MainModelExplorer> createState() => _MainModelExplorerState();
}

class _MainModelExplorerState extends State<MainModelExplorer> {
  @override
  Widget build(BuildContext context) {
    final provider = context.watch<AIEngineProvider>();

    return Scaffold(
      appBar: AppBar(
        title: const Text("AI Global Repository", style: TextStyle(fontWeight: FontWeight.bold)),
        actions: [
          IconButton(icon: const Icon(Icons.security), onPressed: () {}),
          IconButton(icon: const Icon(Icons.history), onPressed: () {}),
        ],
      ),
      body: Column(
        children: [
          _buildHeroSection(),
          Expanded(
            child: ListView.separated(
              padding: const EdgeInsets.all(16),
              itemCount: provider.allModels.length,
              separatorBuilder: (c, i) => const Divider(height: 30),
              itemBuilder: (context, index) {
                return ModelComplexCard(model: provider.allModels[index]);
              },
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildHeroSection() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(20),
      decoration: BoxDecoration(
        color: Colors.indigo.withOpacity(0.1),
        border: Border(bottom: BorderSide(color: Colors.indigo.withOpacity(0.2))),
      ),
      child: const Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text("استكشف موديلات الذكاء الاصطناعي", style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold)),
          Text("تحميل آمن، قانوني، ومباشر إلى جهازك.", style: TextStyle(color: Colors.grey)),
        ],
      ),
    );
  }
}

class ModelComplexCard extends StatelessWidget {
  final AIModel model;
  const ModelComplexCard({super.key, required this.model});

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            _buildCategoryIcon(),
            const SizedBox(width: 15),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(model.name, style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
                  Text("بواسطة: ${model.provider} • نسخة ${model.version}", style: const TextStyle(fontSize: 12, color: Colors.blueGrey)),
                  const SizedBox(height: 5),
                  Text(model.description, style: const TextStyle(fontSize: 14)),
                ],
              ),
            ),
          ],
        ),
        const SizedBox(height: 15),
        _buildActionArea(context),
        const SizedBox(height: 5),
        _buildLegalTag(),
      ],
    );
  }

  Widget _buildCategoryIcon() {
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(color: Colors.indigo, borderRadius: BorderRadius.circular(12)),
      child: const Icon(Icons.psychology, color: Colors.white, size: 30),
    );
  }

  Widget _buildActionArea(BuildContext context) {
    if (model.status == DownloadStatus.downloading) {
      return Column(
        children: [
          LinearPercentIndicator(
            lineHeight: 8.0,
            percent: model.progress,
            backgroundColor: Colors.grey.shade300,
            progressColor: Colors.indigo,
            barRadius: const Radius.circular(10),
          ),
          const SizedBox(height: 5),
          Text("جاري التحميل الآمن: ${(model.progress * 100).toStringAsFixed(1)}%", style: const TextStyle(fontSize: 11)),
        ],
      );
    }

    return SizedBox(
      width: double.infinity,
      child: ElevatedButton.icon(
        icon: Icon(model.status == DownloadStatus.completed ? Icons.play_arrow : Icons.download),
        label: Text(model.status == DownloadStatus.completed ? "تشغيل الموديل محلياً" : "بدء التحميل القانوني"),
        onPressed: () => context.read<AIEngineProvider>().startSecureDownload(model.id),
        style: ElevatedButton.styleFrom(
          backgroundColor: model.status == DownloadStatus.completed ? Colors.green : Colors.indigo,
          foregroundColor: Colors.white,
        ),
      ),
    );
  }

  Widget _buildLegalTag() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
      decoration: BoxDecoration(color: Colors.grey.shade200, borderRadius: BorderRadius.circular(4)),
      child: Text("الرخصة: ${model.licenseType}", style: const TextStyle(fontSize: 10, color: Colors.black54)),
    );
  }
}
